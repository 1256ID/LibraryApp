<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>@ViewBag.Title</title> 
</head>
<body>
    <div class="container-fluid d-flex flex-column align-items-center justify-content-center">
        <header>
            <div class="btn-group" role="group" aria-label="Basic example">
                <a asp-controller="Book" asp-action="Index" class="btn btn-secondary">Index</a>
                <a asp-controller="Book" asp-action="Create" class="btn btn-secondary">Create</a>
            </div>
        </header>

        <h1>@ViewBag.Title</h1>

        <div>
            @RenderBody()
        </div>

    </div>
    <footer class="container-fluid bg-dark text-white py-3 text-center mt-auto p-5">
        &copy; 2025 EmployeesApp. Alla rättigheter förbehållna.
    </footer>

    @RenderSection("scripts", false)
</body>
</html>
