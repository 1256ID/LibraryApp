@model IndexVM

@{
    ViewBag.Title = "Index";
}

<h1>@ViewBag.Title</h1>

<ol>          
    @foreach (var book in Model.BookVMs)
    {                          
        <li>
            <h3>@book.Title</h3>
            <h5>@book.Author</h5>
            <p>@book.Description</p>            
        </li>  
        <a asp-controller="Book" asp-action="Details" asp-route-id=@book.Id>Show details</a>
    }
</ol>

<h3><a asp-controller="Book" asp-action="Create">Create Employee</a></h3>
              